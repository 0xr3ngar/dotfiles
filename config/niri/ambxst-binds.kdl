// Generated from Ambxst's core shortcuts; edit them in Ambxst Settings.
binds {
    Mod+Space repeat=false hotkey-overlay-title="Ambxst: launcher" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run launcher"; }
    Mod+N repeat=false hotkey-overlay-title="Ambxst: dashboard" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run dashboard"; }
    Mod+Shift+A repeat=false hotkey-overlay-title="Ambxst: assistant" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run assistant"; }
    Mod+Ctrl+V repeat=false hotkey-overlay-title="Ambxst: clipboard" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run clipboard"; }
    Mod+Alt+Period repeat=false hotkey-overlay-title="Ambxst: emoji" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run emoji"; }
    Mod+Alt+N repeat=false hotkey-overlay-title="Ambxst: notes" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run notes"; }
    Mod+T repeat=false hotkey-overlay-title="Ambxst: tmux" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run tmux"; }
    Mod+Alt+Comma repeat=false hotkey-overlay-title="Ambxst: wallpapers" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run wallpapers"; }
    Mod+Tab repeat=false hotkey-overlay-title="Ambxst: overview" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run overview"; }
    Mod+Shift+Escape repeat=false hotkey-overlay-title="Ambxst: powermenu" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run powermenu"; }
    Mod+Shift+C repeat=false hotkey-overlay-title="Ambxst: config" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run config"; }
    Mod+S repeat=false hotkey-overlay-title="Ambxst: tools" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run tools"; }
    Mod+Alt+R repeat=false hotkey-overlay-title="Ambxst: screenrecord" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run screenrecord"; }
    Mod+Ctrl+Alt+A repeat=false hotkey-overlay-title="Ambxst: lens" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" run lens"; }
    Mod+Alt+L repeat=false hotkey-overlay-title="Ambxst: lockscreen" { spawn-sh "exec \"$HOME/.local/bin/bun\" \"$HOME/.config/niri/actions.ts\" lock"; }
    Mod+Shift+S repeat=false hotkey-overlay-title="Ambxst: screenshot" { spawn-sh "exec \"$HOME/.local/bin/bun\" \"$HOME/.config/niri/actions.ts\" screenshot-region"; }
    Mod+Alt+B repeat=false hotkey-overlay-title="Ambxst: reload" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" reload"; }
    Mod+Ctrl+Alt+B repeat=false hotkey-overlay-title="Ambxst: quit" { spawn-sh "exec \"$HOME/.local/bin/ambxst\" quit"; }
}
